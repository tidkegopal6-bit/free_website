## Supabase Query Patterns

```typescript
// src/lib/queries/scores.ts

import { supabase } from '../supabase';
import type { GameScore, ApiResponse } from '../../types';

// ✅ Correct — typed, error-handled, no any
export async function getTopScores(gameSlug: string, limit = 10): Promise<ApiResponse<GameScore[]>> {
  const { data, error } = await supabase
    .from('game_scores')
    .select('id, user_id, game_slug, score, achieved_at')
    .eq('game_slug', gameSlug)
    .order('score', { ascending: false })
    .limit(limit);

  if (error) return { data: null, error: error.message };
  return { data: data as GameScore[], error: null };
}

export async function insertScore(gameSlug: string, score: number): Promise<ApiResponse<null>> {
  const { error } = await supabase
    .from('game_scores')
    .insert({ game_slug: gameSlug, score });
    // user_id set by RLS via auth.uid() — never passed from client

  if (error) return { data: null, error: error.message };
  return { data: null, error: null };
}
```

