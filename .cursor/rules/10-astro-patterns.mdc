# 10 — Astro Patterns

## Component Structure
```astro
---
// src/components/blog/BlogCard.astro
// Frontmatter: TypeScript only — runs at BUILD time (SSG) or REQUEST time (SSR)
import type { BlogPost } from '../../types';
import { formatDate } from '../../lib/utils';

interface Props {
  post: BlogPost;
  featured?: boolean;
}

const { post, featured = false } = Astro.props;
const formattedDate = formatDate(post.publishedAt);
---

<!-- Template: HTML + scoped CSS -->
<article class={`card ${featured ? 'card--featured' : ''}`}>
  <a href={`/blog/${post.slug}`}>
    <h2>{post.title}</h2>
    <time datetime={post.publishedAt}>{formattedDate}</time>
    <p>{post.excerpt}</p>
  </a>
</article>

<style>
  /* Scoped to this component — no leaking */
  .card { @apply rounded-lg border border-slate-200 p-4; }
  .card--featured { @apply border-indigo-500 shadow-md; }
</style>
```

