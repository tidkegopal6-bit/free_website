<script>
  const filterBtns = document.querySelectorAll<HTMLButtonElement>('.filter-btn');
  const projectCards = document.querySelectorAll<HTMLElement>('.project-card');
  const emptyState = document.getElementById('emptyState');

  function applyFilter(tag: string) {
    let visibleCount = 0;

    filterBtns.forEach(btn => {
      const isActive = btn.getAttribute('data-filter') === tag;
      if (isActive) {
        btn.className = 'filter-btn px-4 py-1.5 rounded-full text-xs font-semibold border border-indigo-500/30 bg-indigo-500/10 text-indigo-400 cursor-pointer transition-all';
      } else {
        btn.className = 'filter-btn px-4 py-1.5 rounded-full text-xs font-semibold border border-slate-800 bg-slate-950/40 text-slate-400 hover:border-slate-600 hover:text-slate-200 cursor-pointer transition-all';
      }
    });

    projectCards.forEach(card => {
      const cardTags = card.getAttribute('data-tags') || '';
      const matches = tag === 'all' || cardTags.split(',').includes(tag);
      if (matches) {
        card.style.display = '';
        card.style.animation = 'fadeInCard 0.3s ease forwards';
        visibleCount++;
      } else {
        card.style.display = 'none';
      }
    });

    if (emptyState) {
      emptyState.style.display = visibleCount === 0 ? 'block' : 'none';
    }
  }

  filterBtns.forEach(btn => {
    btn.addEventListener('click', () => {
      const tag = btn.getAttribute('data-filter') || 'all';
      applyFilter(tag);
    });
  });
</script>

<style>
  @keyframes fadeInCard {
    from { opacity: 0; transform: translateY(8px); }
    to { opacity: 1; transform: translateY(0); }
  }
</style>
