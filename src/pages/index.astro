---
// src/pages/index.astro
import BaseLayout from '../layouts/BaseLayout.astro';

const features = [
  {
    title: 'Digital Notes',
    description: 'Sync your thoughts with Cloud integration. Rich text, auto-saved securely to Supabase DB.',
    icon: '📝',
    badge: 'Auth Needed',
    color: 'from-blue-500/10 to-indigo-500/10 border-blue-500/20 text-blue-400',
  },
  {
    title: 'Developer Blog',
    description: 'Blazing fast static blog built using Markdown. Stored in Git, served globally with $0 bandwidth cost.',
    icon: '✍️',
    badge: 'Static SSG',
    color: 'from-purple-500/10 to-pink-500/10 border-purple-500/20 text-purple-400',
  },
  {
    title: 'Arcade Hub',
    description: 'Play small canvas browser games in real-time. Track scores and rank on the public leaderboards.',
    icon: '🎮',
    badge: 'HTML5 Canvas',
    color: 'from-emerald-500/10 to-teal-500/10 border-emerald-500/20 text-emerald-400',
  },
  {
    title: 'Bookmarks & Progress',
    description: 'Curate your reading lists and keep track of blog articles you have completed, categorized with tags.',
    icon: '🔖',
    badge: 'Database RLS',
    color: 'from-amber-500/10 to-orange-500/10 border-amber-500/20 text-amber-400',
  },
];

const techStack = [
  { name: 'Astro 5', role: 'SSG & SSR Framework', limit: 'Fast, Hybrid Output Mode', logoBg: 'bg-orange-500/10 text-orange-400' },
  { name: 'Supabase', role: 'DB & Auth & Storage', limit: '500MB DB, 1GB Storage (Free)', logoBg: 'bg-emerald-500/10 text-emerald-400' },
  { name: 'Cloudflare Pages', role: 'Global Hosting', limit: 'Unlimited Bandwidth (Free)', logoBg: 'bg-blue-500/10 text-blue-400' },
  { name: 'Tailwind CSS', role: 'Styles Engine', limit: 'Utility Class Compiler', logoBg: 'bg-cyan-500/10 text-cyan-400' },
];
---

<BaseLayout title="Personal Hub" description="A feature-rich personal website built entirely on free-tier infrastructure.">
  
  <!-- Hero Section -->
  <section class="text-center relative max-w-4xl mx-auto py-12 md:py-20">
    <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full border border-indigo-500/30 bg-indigo-500/5 text-indigo-400 text-xs font-semibold mb-6 tracking-wide uppercase">
      <span class="w-1.5 h-1.5 rounded-full bg-indigo-400 animate-pulse"></span>
      $0 Cost Infrastructure Active
    </div>
    <h1 class="text-4xl sm:text-6xl font-display font-extrabold text-transparent bg-clip-text bg-gradient-to-r from-slate-100 via-indigo-200 to-purple-200 tracking-tight leading-none mb-6">
      Your Personal Web Hub,<br class="hidden sm:inline" /> Fully Powered for <span class="underline decoration-indigo-500 underline-offset-8 decoration-wavy">Zero Cost</span>
    </h1>
    <p class="text-base sm:text-lg text-slate-400 max-w-2xl mx-auto mb-8 font-light leading-relaxed">
      A modern ecosystem featuring notes, blogging, web arcade, and reading trackers.
      Built with Astro, Supabase, Tailwind, and Cloudflare Pages—optimized for fast load speeds and minimal quotas.
    </p>
    <div class="flex flex-col sm:flex-row justify-center items-center gap-4">
      <a href="/login" class="w-full sm:w-auto px-8 py-3 bg-gradient-to-r from-indigo-500 to-purple-500 text-slate-100 font-semibold rounded-xl hover:shadow-lg hover:shadow-indigo-500/20 transform hover:-translate-y-0.5 transition-all duration-200 text-center">
        Explore Dashboard
      </a>
      <a href="#tech" class="w-full sm:w-auto px-8 py-3 bg-slate-900 border border-slate-800 text-slate-300 font-semibold rounded-xl hover:bg-slate-800 hover:text-slate-100 transition-colors text-center">
        Infra Details
      </a>
    </div>
  </section>

  <!-- Features Grid -->
  <section class="py-16 border-t border-slate-900">
    <div class="text-center mb-12">
      <h2 class="text-2xl sm:text-3xl font-display font-bold text-slate-100">Dynamic Modules</h2>
      <p class="text-slate-400 text-sm mt-2">Every feature has been optimized to fit well within free quotas.</p>
    </div>
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
      {features.map(feat => (
        <div class={`p-6 rounded-2xl border bg-slate-950/40 backdrop-blur-sm transition-all duration-300 hover:translate-y-[-2px] hover:border-slate-800 hover:shadow-2xl hover:shadow-indigo-500/5 group flex flex-col justify-between border-slate-900`}>
          <div>
            <div class="flex items-center justify-between mb-4">
              <span class="text-3xl">{feat.icon}</span>
              <span class={`px-2 py-0.5 rounded text-[10px] font-semibold border ${feat.color}`}>
                {feat.badge}
              </span>
            </div>
            <h3 class="text-lg font-semibold text-slate-200 group-hover:text-indigo-300 transition-colors mb-2">
              {feat.title}
            </h3>
            <p class="text-slate-400 text-sm leading-relaxed mb-4">
              {feat.description}
            </p>
          </div>
          <div class="pt-4 border-t border-slate-900/50 flex justify-end">
            <button class="text-xs font-medium text-indigo-400 hover:text-indigo-300 transition-colors flex items-center gap-1">
              Launch Module &rarr;
            </button>
          </div>
        </div>
      ))}
    </div>
  </section>

  <!-- Tech Stack Widget -->
  <section id="tech" class="py-16 border-t border-slate-900">
    <div class="max-w-3xl mx-auto">
      <div class="text-center mb-12">
        <h2 class="text-2xl sm:text-3xl font-display font-bold text-slate-100">Free Tier Architecture</h2>
        <p class="text-slate-400 text-sm mt-2">Rigorous verification ensures zero ongoing costs.</p>
      </div>
      <div class="space-y-4">
        {techStack.map(tech => (
          <div class="flex flex-col sm:flex-row sm:items-center justify-between p-4 rounded-xl border border-slate-900 bg-slate-950/30 hover:border-slate-800 transition-colors gap-3">
            <div class="flex items-center space-x-3">
              <div class={`w-10 h-10 rounded-lg flex items-center justify-center font-bold text-sm ${tech.logoBg}`}>
                {tech.name[0]}
              </div>
              <div>
                <h4 class="font-semibold text-slate-200 text-sm">{tech.name}</h4>
                <p class="text-xs text-slate-500">{tech.role}</p>
              </div>
            </div>
            <div class="text-xs bg-slate-900 px-3 py-1.5 rounded-lg border border-slate-800 text-slate-300 font-mono self-start sm:self-auto">
              {tech.limit}
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- CTA Login -->
  <section class="mt-12 p-8 rounded-2xl bg-gradient-to-r from-indigo-950/30 via-slate-950 to-purple-950/30 border border-slate-900 text-center max-w-3xl mx-auto">
    <h2 class="text-xl sm:text-2xl font-display font-bold text-slate-100 mb-2">Connect Your Account</h2>
    <p class="text-slate-400 text-sm max-w-md mx-auto mb-6">
      Log in with Google to enable profile settings, bookmarks, public leaderboards, and private database notes.
    </p>
    <button class="px-6 py-2.5 bg-slate-900 border border-slate-800 text-slate-200 hover:text-slate-100 hover:bg-slate-800 hover:border-slate-700 font-medium rounded-lg text-sm transition-all duration-200 inline-flex items-center gap-2 cursor-pointer">
      <svg class="w-4 h-4" viewBox="0 0 24 24" fill="currentColor">
        <path d="M12.24 10.285V13.4h6.887c-.648 2.41-2.519 4.19-5.136 4.19A5.46 5.46 0 0 1 8.53 12c0-3.01 2.45-5.46 5.46-5.46 1.366 0 2.614.508 3.57 1.346l2.39-2.39C18.23 3.905 16.273 3 13.99 3 9.022 3 5 7.022 5 12c0 4.978 4.022 9 8.99 9 5.203 0 8.65-3.66 8.65-8.805 0-.618-.057-1.173-.173-1.61H12.24z"/>
      </svg>
      Continue with Google
    </button>
  </section>

</BaseLayout>
