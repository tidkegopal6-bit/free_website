---
// src/pages/games/index.astro
import BaseLayout from '../../layouts/BaseLayout.astro';

const games = [
  {
    slug: 'snake',
    title: 'Retro Snake',
    description: 'The classic Nokia game. Eat food, grow longer, avoid the walls and your own tail!',
    icon: '🐍',
    badge: 'Play Now',
    color: 'from-emerald-500/10 to-teal-500/10 border-emerald-500/20 text-emerald-400',
    available: true
  },
  {
    slug: 'tetris',
    title: 'Block Fall (Tetris)',
    description: 'Rotate and fit falling blocks to complete horizontal lines. Strategy and reflexes combined.',
    icon: '🧱',
    badge: 'Coming Soon',
    color: 'from-blue-500/10 to-indigo-500/10 border-blue-500/20 text-blue-400',
    available: false
  },
  {
    slug: 'invaders',
    title: 'Space Invaders',
    description: 'Defend your planet from waves of descending alien spaceships. Classic arcade shooter.',
    icon: '🚀',
    badge: 'Coming Soon',
    color: 'from-purple-500/10 to-pink-500/10 border-purple-500/20 text-purple-400',
    available: false
  }
];
---

<BaseLayout title="Arcade Hub" description="Play free retro browser games and rank on the global leaderboards.">
  <div class="space-y-12">
    <!-- Hub Header -->
    <div class="text-center max-w-2xl mx-auto space-y-4">
      <h1 class="text-4xl font-display font-extrabold text-slate-100 tracking-tight leading-none">
        Retro Arcade Hub
      </h1>
      <p class="text-sm text-slate-400 font-light leading-relaxed">
        Play canvas games built entirely in your browser with zero input lag. 
        Log in with Google to submit your high scores to the global leaderboard.
      </p>
    </div>

    <!-- Layout Grid: Games List vs Global Leaderboard -->
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
      
      <!-- Games List (2/3 width on desktop) -->
      <div class="lg:col-span-2 space-y-6">
        <h2 class="text-xl font-display font-bold text-slate-200 border-b border-slate-900 pb-3">Available Games</h2>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
          {games.map(game => (
            <div class="p-6 rounded-2xl border border-slate-900 bg-slate-950/40 hover:border-slate-800 transition-all duration-200 group flex flex-col justify-between">
              <div>
                <div class="flex items-center justify-between mb-4">
                  <span class="text-3xl">{game.icon}</span>
                  <span class={`px-2 py-0.5 rounded text-[10px] font-bold border ${game.color}`}>
                    {game.badge}
                  </span>
                </div>
                <h3 class="text-base font-display font-bold text-slate-200 group-hover:text-indigo-400 transition-colors mb-2">
                  {game.title}
                </h3>
                <p class="text-xs text-slate-400 leading-relaxed font-light mb-4">
                  {game.description}
                </p>
              </div>
              
              <div class="pt-4 border-t border-slate-900/50 mt-auto flex justify-end">
                {game.available ? (
                  <a href={`/games/${game.slug}`} class="px-4 py-1.5 bg-indigo-600 hover:bg-indigo-500 text-slate-100 text-xs font-semibold rounded-lg shadow-sm hover:shadow-indigo-500/20 cursor-pointer transition-all">
                    Launch Game &rarr;
                  </a>
                ) : (
                  <button disabled class="px-4 py-1.5 bg-slate-900 border border-slate-850 text-slate-500 text-xs font-semibold rounded-lg cursor-not-allowed">
                    Locked
                  </button>
                )}
              </div>
            </div>
          ))}
        </div>
      </div>

      <!-- Global Leaderboard (1/3 width on desktop) -->
      <div class="space-y-6">
        <h2 class="text-xl font-display font-bold text-slate-200 border-b border-slate-900 pb-3">Global Top 10</h2>
        <div class="p-6 rounded-2xl border border-slate-900 bg-slate-950/40 shadow-xl relative overflow-hidden">
          <!-- Top indicator glow -->
          <div class="absolute top-0 left-0 right-0 h-[2px] bg-gradient-to-r from-indigo-500 to-purple-500 opacity-40"></div>
          
          <!-- Loading state -->
          <div id="boardLoading" class="flex flex-col items-center justify-center py-12 space-y-3">
            <div class="animate-spin rounded-full h-6 w-6 border-t-2 border-b-2 border-indigo-500"></div>
            <p class="text-[10px] text-slate-500 font-mono">Syncing Scores...</p>
          </div>

          <!-- Empty state -->
          <div id="boardEmpty" class="hidden text-center py-12 text-slate-500 text-xs font-light">
            No high scores recorded yet. Be the first to play!
          </div>

          <!-- Leaderboard Table -->
          <div id="boardContent" class="hidden">
            <table class="w-full text-xs text-left">
              <thead>
                <tr class="border-b border-slate-900 pb-2 text-[10px] text-slate-500 uppercase font-bold tracking-wider">
                  <th class="py-2 pr-2">Rank</th>
                  <th class="py-2">Player</th>
                  <th class="py-2 text-center">Game</th>
                  <th class="py-2 text-right">Score</th>
                </tr>
              </thead>
              <tbody id="leaderboardBody" class="divide-y divide-slate-900/40 text-slate-300">
                <!-- Renders dynamically -->
              </tbody>
            </table>
          </div>
        </div>
      </div>
    </div>
  </div>

  <script>
    import { supabase } from '../../lib/supabase';

    const boardLoading = document.getElementById('boardLoading');
    const boardEmpty = document.getElementById('boardEmpty');
    const boardContent = document.getElementById('boardContent');
    const leaderboardBody = document.getElementById('leaderboardBody');

    async function loadGlobalLeaderboard() {
      // Query top scores joining user profile details
      const { data: scores, error } = await supabase
        .from('game_scores')
        .select(`
          score,
          game_slug,
          profiles (username)
        `)
        .order('score', { ascending: false })
        .limit(10);

      if (boardLoading) boardLoading.classList.add('hidden');

      if (error) {
        console.error('Leaderboard query failed:', error.message);
        if (boardEmpty) {
          boardEmpty.classList.remove('hidden');
          boardEmpty.textContent = 'Failed to load scores.';
        }
        return;
      }

      if (!scores || scores.length === 0) {
        if (boardEmpty) boardEmpty.classList.remove('hidden');
        return;
      }

      // Populate Table
      if (leaderboardBody && boardContent) {
        leaderboardBody.innerHTML = '';
        scores.forEach((s: any, index) => {
          const rank = index + 1;
          const username = s.profiles?.username || 'player';
          
          // Rank highlighting styles
          let rankBadge = `${rank}`;
          if (rank === 1) rankBadge = '🥇';
          else if (rank === 2) rankBadge = '🥈';
          else if (rank === 3) rankBadge = '🥉';

          const gameLabel = s.game_slug === 'snake' ? 'Snake' : s.game_slug;

          const row = document.createElement('tr');
          row.className = 'hover:bg-slate-950/20 transition-colors';
          row.innerHTML = `
            <td class="py-3 font-semibold text-slate-400 pr-2">${rankBadge}</td>
            <td class="py-3 font-medium text-slate-200 truncate max-w-[100px]" title="@${username}">@${username}</td>
            <td class="py-3 text-center font-mono text-[10px] text-slate-500">${gameLabel}</td>
            <td class="py-3 text-right font-display font-extrabold text-indigo-400 text-sm">${s.score}</td>
          `;
          leaderboardBody.appendChild(row);
        });
        boardContent.classList.remove('hidden');
      }
    }

    loadGlobalLeaderboard();
  </script>
</BaseLayout>
