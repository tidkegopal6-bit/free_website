---
// src/pages/games/[slug].astro
import BaseLayout from '../../layouts/BaseLayout.astro';

export async function getStaticPaths() {
  return [
    { params: { slug: 'snake' } }
  ];
}

const { slug } = Astro.params;

// Strictly allow only 'snake' for now
if (slug !== 'snake') {
  return Astro.redirect('/games');
}
---

<BaseLayout title="Retro Snake" description="Classic Snake game. Play and rank on the leaderboards.">
  <div class="space-y-6">
    <!-- Breadcrumb back -->
    <div class="flex items-center justify-between border-b border-slate-900 pb-4">
      <a href="/games" class="text-xs text-slate-500 hover:text-indigo-400 transition-colors flex items-center gap-1">
        &larr; Return to Arcade Hub
      </a>
      <span class="text-xs font-mono text-indigo-400 font-semibold tracking-wide uppercase">Arcade Mode</span>
    </div>

    <!-- Main Game Section Grid -->
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
      
      <!-- Canvas Box & Virtual Pad (2/3 width on desktop) -->
      <div id="gameWrapper" data-slug={slug} class="lg:col-span-2 flex flex-col items-center p-6 rounded-2xl bg-slate-950/40 border border-slate-900 shadow-2xl relative overflow-hidden gap-6">
        
        <!-- Game Stats Row -->
        <div class="w-full flex items-center justify-between px-2">
          <div class="flex items-center gap-4">
            <div class="text-xs font-bold text-slate-500 uppercase tracking-wide">
              Score: <span id="currentScore" class="text-slate-100 text-sm font-display font-extrabold ml-1">0</span>
            </div>
            <div class="text-xs font-bold text-slate-500 uppercase tracking-wide">
              High: <span id="localHighscore" class="text-slate-100 text-sm font-display font-extrabold ml-1">0</span>
            </div>
          </div>
          <!-- Game State Indicator -->
          <div id="gameStatusIndicator" class="text-[10px] uppercase font-bold tracking-wider text-slate-500 font-mono">
            Press Start
          </div>
        </div>

        <!-- Control Options Bar -->
        <div class="w-full flex flex-wrap items-center justify-between gap-3 px-2 border-b border-slate-900/60 pb-4">
          <!-- Control Scheme -->
          <div class="flex items-center gap-1 bg-slate-950 border border-slate-900 p-1 rounded-xl text-xs">
            <button id="ctrlKeyboardBtn" class="px-2.5 py-1 rounded-lg font-semibold cursor-pointer transition-all bg-indigo-600/20 border border-indigo-500/30 text-indigo-400">
              ⌨️ Keyboard
            </button>
            <button id="ctrlTouchBtn" class="px-2.5 py-1 rounded-lg font-semibold cursor-pointer transition-all text-slate-500 hover:text-slate-300">
              📱 Touch D-Pad
            </button>
          </div>

          <!-- Extra Options -->
          <div class="flex flex-wrap items-center gap-3 text-xs">
            <!-- Theme Select -->
            <div class="flex items-center gap-1 bg-slate-950 border border-slate-900 p-1 rounded-xl">
              <span class="text-[10px] font-bold text-slate-500 uppercase tracking-wide px-1.5">Theme:</span>
              <select id="gameThemeSelector" class="bg-transparent border-0 text-slate-300 focus:outline-none text-[11px] font-semibold pr-2 cursor-pointer">
                <option value="dark" class="bg-slate-950 text-slate-300">Slate Dark</option>
                <option value="light" class="bg-slate-950 text-slate-300">Classic Light</option>
                <option value="gameboy" class="bg-slate-950 text-slate-300">Retro Gameboy</option>
                <option value="cyberpunk" class="bg-slate-950 text-slate-300">Neon Cyberpunk</option>
              </select>
            </div>

            <!-- Starting Speed -->
            <div class="flex items-center gap-1 bg-slate-950 border border-slate-900 p-1 rounded-xl">
              <span class="text-[10px] font-bold text-slate-500 uppercase tracking-wide px-1.5">Speed:</span>
              <select id="gameSpeedSelector" class="bg-transparent border-0 text-slate-300 focus:outline-none text-[11px] font-semibold pr-2 cursor-pointer">
                <option value="240" class="bg-slate-950 text-slate-300">Slow</option>
                <option value="160" selected class="bg-slate-950 text-slate-300">Normal</option>
                <option value="100" class="bg-slate-950 text-slate-300">Fast</option>
              </select>
            </div>

            <!-- Zen Mode Toggle -->
            <button id="zenModeBtn" class="px-3 py-1.5 rounded-xl bg-slate-950 border border-slate-900 text-slate-500 hover:text-slate-300 font-semibold cursor-pointer transition-all flex items-center gap-1">
              <span>🛡️</span> <span id="zenModeLabel">Zen Mode Off</span>
            </button>

            <!-- Full Window Mode Toggle -->
            <button id="fullWindowBtn" class="px-3 py-1.5 rounded-xl bg-slate-950 border border-slate-900 text-slate-500 hover:text-slate-300 font-semibold cursor-pointer transition-all flex items-center gap-1">
              <span>🖥️</span> <span id="fullWindowLabel">Expand</span>
            </button>
          </div>
        </div>

        <!-- Canvas Container -->
        <div id="canvasContainer" class="relative w-full max-w-[400px] aspect-square rounded-xl overflow-hidden border-2 border-slate-900 bg-slate-950 flex items-center justify-center transition-all duration-300">
          <canvas id="gameCanvas" width="400" height="400" class="w-full h-full block"></canvas>
          
          <!-- Splash Screens overlay (Start/Game Over) -->
          <div id="gameOverlay" class="absolute inset-0 bg-slate-950/90 flex flex-col items-center justify-center p-6 text-center space-y-4">
            <span class="text-5xl block animate-bounce" id="overlayEmoji">🐍</span>
            <h2 id="overlayTitle" class="text-xl sm:text-2xl font-display font-extrabold text-slate-100 tracking-tight">Retro Snake</h2>
            <p id="overlayText" class="text-xs text-slate-400 max-w-xs font-light">
              Use your arrow keys or the virtual D-Pad below to guide the snake. Eat food and avoid crashing.
            </p>
            <button id="startGameBtn" class="px-6 py-2.5 bg-gradient-to-r from-indigo-500 to-purple-500 hover:shadow-indigo-500/20 shadow-md text-slate-100 text-sm font-bold rounded-xl cursor-pointer transition-all">
              Start Game
            </button>
          </div>
        </div>

        <!-- Virtual Mobile D-Pad (Conditionally visible via controls selector) -->
        <div id="virtualDpadContainer" class="hidden flex-col items-center gap-1.5 w-full max-w-[180px] animate-fade-in">
          <!-- Up Button -->
          <button id="padUp" class="w-12 h-12 flex items-center justify-center rounded-xl bg-slate-900 hover:bg-slate-800 border border-slate-850 active:bg-indigo-950 active:border-indigo-800 text-slate-300 transition-colors shadow-sm select-none cursor-pointer">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" d="M4.5 15.75l7.5-7.5 7.5 7.5"/>
            </svg>
          </button>
          <div class="flex gap-7">
            <!-- Left Button -->
            <button id="padLeft" class="w-12 h-12 flex items-center justify-center rounded-xl bg-slate-900 hover:bg-slate-800 border border-slate-850 active:bg-indigo-950 active:border-indigo-800 text-slate-300 transition-colors shadow-sm select-none cursor-pointer">
              <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 19.5L8.25 12l7.5-7.5"/>
              </svg>
            </button>
            <!-- Right Button -->
            <button id="padRight" class="w-12 h-12 flex items-center justify-center rounded-xl bg-slate-900 hover:bg-slate-800 border border-slate-850 active:bg-indigo-950 active:border-indigo-800 text-slate-300 transition-colors shadow-sm select-none cursor-pointer">
              <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" d="M8.25 4.5l7.5 7.5-7.5 7.5"/>
              </svg>
            </button>
          </div>
          <!-- Down Button -->
          <button id="padDown" class="w-12 h-12 flex items-center justify-center rounded-xl bg-slate-900 hover:bg-slate-800 border border-slate-850 active:bg-indigo-950 active:border-indigo-800 text-slate-300 transition-colors shadow-sm select-none cursor-pointer">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 8.25l-7.5 7.5-7.5-7.5"/>
            </svg>
          </button>
        </div>
      </div>

      <!-- Game Specific Leaderboard Sidebar (1/3 width on desktop) -->
      <div class="space-y-6">
        
        <!-- Guest Notice Box -->
        <div id="authNotice" class="p-5 rounded-2xl border border-slate-900 bg-slate-950/30 text-center space-y-3">
          <span class="text-xl">🔒</span>
          <h4 class="text-xs font-bold text-slate-300 uppercase tracking-wide">Sync is Offline</h4>
          <p class="text-[11px] text-slate-500 leading-relaxed font-light">
            You are playing as a guest. Log in to synchronize your score on the leaderboard.
          </p>
          <a href="/login" class="inline-block px-4 py-1.5 bg-slate-900 border border-slate-850 text-slate-300 hover:text-slate-100 text-xs font-semibold rounded-lg hover:bg-slate-800 transition-all cursor-pointer">
            Login Now
          </a>
        </div>

        <!-- Leaderboard Table card -->
        <div class="space-y-4">
          <h3 class="text-base font-display font-bold text-slate-200 border-b border-slate-900 pb-2">Snake Leaders</h3>
          <div class="p-6 rounded-2xl border border-slate-900 bg-slate-950/40 relative overflow-hidden">
            <div id="gameBoardLoading" class="flex flex-col items-center justify-center py-10 space-y-2">
              <div class="animate-spin rounded-full h-5 w-5 border-t-2 border-b-2 border-indigo-500"></div>
            </div>
            
            <div id="gameBoardEmpty" class="hidden text-center py-10 text-slate-500 text-xs font-light">
              No local scores submitted. Be the first!
            </div>

            <div id="gameBoardContent" class="hidden">
              <table class="w-full text-[11px] text-left">
                <thead>
                  <tr class="border-b border-slate-900 pb-2 text-[9px] text-slate-500 uppercase font-bold tracking-wider">
                    <th class="py-1.5 pr-2">Rank</th>
                    <th class="py-1.5">Player</th>
                    <th class="py-1.5 text-right">Score</th>
                  </tr>
                </thead>
                <tbody id="gameLeaderboardBody" class="divide-y divide-slate-900/40 text-slate-400">
                  <!-- populated dynamically -->
                </tbody>
              </table>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <script>
    // Cache bust: force recompile v2.0.1
    import { supabase } from '../../lib/supabase';

    const gameWrapper = document.getElementById('gameWrapper');
    const slug = gameWrapper?.getAttribute('data-slug') || 'snake';

    // Game Core Canvas elements
    const canvas = document.getElementById('gameCanvas');
    const ctx = canvas.getContext('2d');
    const overlay = document.getElementById('gameOverlay');
    const overlayTitle = document.getElementById('overlayTitle');
    const overlayText = document.getElementById('overlayText');
    const overlayEmoji = document.getElementById('overlayEmoji');
    const startBtn = document.getElementById('startGameBtn');
    
    // UI Panels
    const currentScoreEl = document.getElementById('currentScore');
    const localHighscoreEl = document.getElementById('localHighscore');
    const gameStatusIndicator = document.getElementById('gameStatusIndicator');
    const authNotice = document.getElementById('authNotice');

    // Controls Selectors
    const ctrlKeyboardBtn = document.getElementById('ctrlKeyboardBtn');
    const ctrlTouchBtn = document.getElementById('ctrlTouchBtn');
    const virtualDpadContainer = document.getElementById('virtualDpadContainer');

    // Options Selectors
    const gameSpeedSelector = document.getElementById('gameSpeedSelector') as HTMLSelectElement;
    const gameThemeSelector = document.getElementById('gameThemeSelector') as HTMLSelectElement;
    const zenModeBtn = document.getElementById('zenModeBtn');
    const zenModeLabel = document.getElementById('zenModeLabel');
    const fullWindowBtn = document.getElementById('fullWindowBtn');
    const fullWindowLabel = document.getElementById('fullWindowLabel');
    const canvasContainer = document.getElementById('canvasContainer');

    // Themes configuration
    const THEMES = {
      dark: {
        bg: '#020617',        // slate-950
        grid: '#0f172a',      // slate-900
        snakeHead: '#6366f1', // indigo-500
        snakeBody: '#a855f7', // purple-500
        food: '#f43f5e',      // rose-500
        glow: '#f43f5e',
        glowPower: 8
      },
      light: {
        bg: '#ffffff',        // clean white
        grid: '#f1f5f9',      // slate-100
        snakeHead: '#2563eb', // blue-600
        snakeBody: '#3b82f6', // blue-500
        food: '#e11d48',      // rose-600
        glow: '#e11d48',
        glowPower: 0
      },
      gameboy: {
        bg: '#8bac0f',        // retro green-yellow screen
        grid: '#9bbc0f',      // grid lines
        snakeHead: '#0f380f', // dark pine green
        snakeBody: '#306230', // medium dark forest green
        food: '#0f380f',      // dark pine green
        glow: '#0f380f',
        glowPower: 0
      },
      cyberpunk: {
        bg: '#0a0014',        // neon deep dark purple/black
        grid: '#1a0033',      // grid border lines
        snakeHead: '#39ff14', // hot neon green
        snakeBody: '#00ffff', // cyan body
        food: '#ff007f',      // hot neon pink
        glow: '#ff007f',
        glowPower: 12
      }
    };

    // Option state variables
    let isZenMode = false;
    let startingSpeed = 160;
    let currentThemeName = 'dark';

    function syncCanvasThemeWithGlobal() {
      const globalTheme = document.documentElement.getAttribute('data-theme') || 'slate-dark';
      let targetCanvasTheme = 'dark';
      
      if (globalTheme === 'warm-sepi') {
        targetCanvasTheme = 'gameboy';
      } else if (globalTheme === 'classic-light') {
        targetCanvasTheme = 'light';
      } else if (globalTheme === 'dim-blue') {
        targetCanvasTheme = 'cyberpunk';
      } else if (globalTheme === 'warm-dark') {
        targetCanvasTheme = 'cyberpunk';
      } else {
        targetCanvasTheme = 'dark';
      }

      currentThemeName = targetCanvasTheme;
      if (gameThemeSelector) {
        gameThemeSelector.value = targetCanvasTheme;
      }
      drawGame();
    }

    // Observe global theme changes
    const observer = new MutationObserver((mutations) => {
      mutations.forEach((mutation) => {
        if (mutation.attributeName === 'data-theme') {
          syncCanvasThemeWithGlobal();
        }
      });
    });
    observer.observe(document.documentElement, { attributes: true });

    // Sidebar Board elements
    const gameBoardLoading = document.getElementById('gameBoardLoading');
    const gameBoardEmpty = document.getElementById('gameBoardEmpty');
    const gameBoardContent = document.getElementById('gameBoardContent');
    const gameLeaderboardBody = document.getElementById('gameLeaderboardBody');

    // Virtual Pad controls
    const padUp = document.getElementById('padUp');
    const padDown = document.getElementById('padDown');
    const padLeft = document.getElementById('padLeft');
    const padRight = document.getElementById('padRight');

    function selectKeyboard() {
      if (!ctrlKeyboardBtn || !ctrlTouchBtn || !virtualDpadContainer) return;
      ctrlKeyboardBtn.className = 'px-2.5 py-1 rounded-lg font-semibold cursor-pointer transition-all bg-indigo-600/20 border border-indigo-500/30 text-indigo-400';
      ctrlTouchBtn.className = 'px-2.5 py-1 rounded-lg font-semibold cursor-pointer transition-all text-slate-500 hover:text-slate-300 border border-transparent';
      virtualDpadContainer.classList.add('hidden');
      virtualDpadContainer.classList.remove('flex');
    }

    function selectTouch() {
      if (!ctrlKeyboardBtn || !ctrlTouchBtn || !virtualDpadContainer) return;
      ctrlTouchBtn.className = 'px-2.5 py-1 rounded-lg font-semibold cursor-pointer transition-all bg-indigo-600/20 border border-indigo-500/30 text-indigo-400';
      ctrlKeyboardBtn.className = 'px-2.5 py-1 rounded-lg font-semibold cursor-pointer transition-all text-slate-500 hover:text-slate-300 border border-transparent';
      virtualDpadContainer.classList.remove('hidden');
      virtualDpadContainer.classList.add('flex');
    }

    // Auto detect touch interface
    const hasTouch = 'ontouchstart' in window || navigator.maxTouchPoints > 0;
    if (hasTouch) {
      selectTouch();
    } else {
      selectKeyboard();
    }

    ctrlKeyboardBtn?.addEventListener('click', selectKeyboard);
    ctrlTouchBtn?.addEventListener('click', selectTouch);

    // Speed Selector listener
    gameSpeedSelector?.addEventListener('change', (e) => {
      const target = e.target;
      startingSpeed = parseInt(target.value, 10);
      if (!isGameActive) {
        gameSpeed = startingSpeed;
      }
    });

    // Theme Selector listener
    gameThemeSelector?.addEventListener('change', (e) => {
      const target = e.target;
      currentThemeName = target.value;
      drawGame();
    });

    // Zen Mode Toggle
    zenModeBtn?.addEventListener('click', () => {
      isZenMode = !isZenMode;
      if (isZenMode) {
        zenModeBtn.className = 'px-3 py-1.5 rounded-xl bg-emerald-950/20 border border-emerald-500/30 text-emerald-400 font-semibold cursor-pointer transition-all flex items-center gap-1';
        if (zenModeLabel) zenModeLabel.textContent = 'Zen Mode On';
      } else {
        zenModeBtn.className = 'px-3 py-1.5 rounded-xl bg-slate-950 border border-slate-900 text-slate-500 hover:text-slate-300 font-semibold cursor-pointer transition-all flex items-center gap-1';
        if (zenModeLabel) zenModeLabel.textContent = 'Zen Mode Off';
      }
    });

    // Full Window Expand Toggle
    fullWindowBtn?.addEventListener('click', () => {
      if (!gameWrapper || !fullWindowBtn || !fullWindowLabel || !canvasContainer) return;

      const isExpanded = gameWrapper.classList.contains('fixed');
      if (isExpanded) {
        // Shrink back to normal
        gameWrapper.className = 'lg:col-span-2 flex flex-col items-center p-6 rounded-2xl bg-slate-950/40 border border-slate-900 shadow-2xl relative overflow-hidden gap-6';
        canvasContainer.className = 'relative w-full max-w-[400px] aspect-square rounded-xl overflow-hidden border-2 border-slate-900 bg-slate-950 flex items-center justify-center transition-all duration-300';
        fullWindowLabel.textContent = 'Expand';
        fullWindowBtn.className = 'px-3 py-1.5 rounded-xl bg-slate-950 border border-slate-900 text-slate-500 hover:text-slate-300 font-semibold cursor-pointer transition-all flex items-center gap-1';
      } else {
        // Expand to full viewport window
        gameWrapper.className = 'fixed inset-0 z-[100] bg-slate-950 flex flex-col items-center justify-center p-6 h-screen w-screen overflow-y-auto gap-6';
        canvasContainer.className = 'relative w-full max-w-[80vh] aspect-square rounded-xl overflow-hidden border-2 border-slate-900 bg-slate-950 flex items-center justify-center transition-all duration-300';
        fullWindowLabel.textContent = 'Shrink';
        fullWindowBtn.className = 'px-3 py-1.5 rounded-xl bg-indigo-950/20 border border-indigo-500/30 text-indigo-400 font-semibold cursor-pointer transition-all flex items-center gap-1';
      }
      // Trigger canvas sizing adjustment
      setTimeout(resizeCanvas, 50);
    });

    // Grid details
    const gridSize = 20;
    const gridCount = 20;
    let cellPixelSize = 400 / gridCount; // 20px

    function resizeCanvas() {
      if (!canvas || !canvasContainer) return;
      const isExpanded = gameWrapper?.classList.contains('fixed');
      if (isExpanded) {
        const rect = canvasContainer.getBoundingClientRect();
        // Keep square and responsive to container size
        const size = Math.min(rect.width, rect.height) - 16;
        canvas.width = size;
        canvas.height = size;
      } else {
        canvas.width = 400;
        canvas.height = 400;
      }
      cellPixelSize = canvas.width / gridCount;
      drawGame();
    }

    window.addEventListener('resize', resizeCanvas);

    let snake = [];
    let direction = 'right';
    let food = { x: 0, y: 0 };
    let score = 0;
    let localHighscore = 0;
    let gameInterval = null;
    let gameSpeed = 160; // milliseconds
    let isGameActive = false;
    let currentUserId = null;

    async function initPage() {
      // 1. Get active session state
      const { data: { session } } = await supabase.auth.getSession();
      if (session) {
        currentUserId = session.user.id;
        if (authNotice) authNotice.classList.add('hidden'); // Hide guest banner
      }

      // 2. Load high scores
      loadLocalHighscore();
      loadGameLeaderboard();
      syncCanvasThemeWithGlobal(); // Sync initial canvas theme
      drawInitialCanvas();
    }

    function loadLocalHighscore() {
      const saved = localStorage.getItem(`high_${slug}`);
      if (saved) {
        localHighscore = parseInt(saved, 10);
        if (localHighscoreEl) localHighscoreEl.textContent = saved;
      }
    }

    async function loadGameLeaderboard() {
      const { data: scores, error } = await supabase
        .from('game_scores')
        .select(`
          score,
          profiles (username)
        `)
        .eq('game_slug', slug)
        .order('score', { ascending: false })
        .limit(10);

      if (gameBoardLoading) gameBoardLoading.classList.add('hidden');

      if (error) {
        console.error('Leaderboard load failed:', error.message);
        if (gameBoardEmpty) gameBoardEmpty.classList.remove('hidden');
        return;
      }

      if (!scores || scores.length === 0) {
        if (gameBoardEmpty) gameBoardEmpty.classList.remove('hidden');
        return;
      }

      if (gameLeaderboardBody && gameBoardContent) {
        if (gameBoardEmpty) gameBoardEmpty.classList.add('hidden');
        gameLeaderboardBody.innerHTML = '';
        
        scores.forEach((s, idx) => {
          const rank = idx + 1;
          const username = s.profiles?.username || 'player';
          
          let rankBadge = `${rank}`;
          if (rank === 1) rankBadge = '🥇';
          else if (rank === 2) rankBadge = '🥈';
          else if (rank === 3) rankBadge = '🥉';

          const row = document.createElement('tr');
          row.className = 'hover:bg-slate-950/20';
          row.innerHTML = `
            <td class="py-2 font-semibold text-slate-500 pr-2">${rankBadge}</td>
            <td class="py-2 font-medium text-slate-200 truncate max-w-[80px]" title="@${username}">@${username}</td>
            <td class="py-2 text-right font-display font-extrabold text-indigo-400">${s.score}</td>
          `;
          gameLeaderboardBody.appendChild(row);
        });

        gameBoardContent.classList.remove('hidden');
      }
    }

    function drawInitialCanvas() {
      const theme = THEMES[currentThemeName];
      ctx.fillStyle = theme.bg;
      ctx.fillRect(0, 0, canvas.width, canvas.height);
      
      // Draw grid lines faintly
      ctx.strokeStyle = theme.grid;
      ctx.lineWidth = 1;
      for (let i = 0; i <= gridCount; i++) {
        ctx.beginPath();
        ctx.moveTo(i * cellPixelSize, 0);
        ctx.lineTo(i * cellPixelSize, canvas.height);
        ctx.stroke();

        ctx.beginPath();
        ctx.moveTo(0, i * cellPixelSize);
        ctx.lineTo(canvas.width, i * cellPixelSize);
        ctx.stroke();
      }
    }

    // Initialize Game Loops
    function startNewGame() {
      // Clear interval if running
      if (gameInterval) clearInterval(gameInterval);

      // Initialize defaults
      snake = [
        { x: 10, y: 10 },
        { x: 9, y: 10 },
        { x: 8, y: 10 }
      ];
      direction = 'right';
      score = 0;
      gameSpeed = startingSpeed;
      isGameActive = true;

      if (currentScoreEl) currentScoreEl.textContent = '0';
      if (gameStatusIndicator) {
        gameStatusIndicator.textContent = 'Active';
        gameStatusIndicator.className = 'text-[10px] uppercase font-bold tracking-wider text-emerald-400 font-mono';
      }

      spawnFood();
      if (overlay) {
        overlay.classList.add('hidden');
        overlay.classList.remove('flex');
      }
      
      // Start clock
      gameInterval = setInterval(gameTick, gameSpeed);
    }

    function spawnFood() {
      while (true) {
        const x = Math.floor(Math.random() * gridCount);
        const y = Math.floor(Math.random() * gridCount);
        
        // Ensure food does not spawn inside the snake body
        const overlap = snake.some(part => part.x === x && part.y === y);
        if (!overlap) {
          food = { x, y };
          break;
        }
      }
    }

    function gameTick() {
      moveSnake();
      checkCollisions();
      drawGame();
    }

    function moveSnake() {
      const head = { ...snake[0] };

      switch (direction) {
        case 'up': head.y -= 1; break;
        case 'down': head.y += 1; break;
        case 'left': head.x -= 1; break;
        case 'right': head.x += 1; break;
      }

      // Screen wrapping (walls connect to the opposite side)
      if (head.x < 0) head.x = gridCount - 1;
      else if (head.x >= gridCount) head.x = 0;

      if (head.y < 0) head.y = gridCount - 1;
      else if (head.y >= gridCount) head.y = 0;

      // Add new head coordinate
      snake.unshift(head);

      // Check if food eaten
      if (head.x === food.x && head.y === food.y) {
        score += 10;
        if (currentScoreEl) currentScoreEl.textContent = score;
        spawnFood();
        
        // Speed scaling trigger
        if (score % 50 === 0 && gameSpeed > 60) {
          gameSpeed -= 10;
          clearInterval(gameInterval);
          gameInterval = setInterval(gameTick, gameSpeed);
        }
      } else {
        // Pop tail if no food eaten
        snake.pop();
      }
    }

    function checkCollisions() {
      const head = snake[0];

      // Self crash (skip index 0 head) - disabled in Zen Mode
      if (!isZenMode) {
        for (let i = 1; i < snake.length; i++) {
          if (head.x === snake[i].x && head.y === snake[i].y) {
            triggerGameOver();
            return;
          }
        }
      }
    }

    async function triggerGameOver() {
      isGameActive = false;
      clearInterval(gameInterval);

      if (gameStatusIndicator) {
        gameStatusIndicator.textContent = 'Game Over';
        gameStatusIndicator.className = 'text-[10px] uppercase font-bold tracking-wider text-red-500 font-mono';
      }

      // High score caching
      let highscoreBeaten = false;
      if (score > localHighscore) {
        localHighscore = score;
        localStorage.setItem(`high_${slug}`, score.toString());
        if (localHighscoreEl) localHighscoreEl.textContent = score.toString();
        highscoreBeaten = true;
      }

      // Save score to database (if authenticated and NOT in Zen mode)
      if (currentUserId && score > 0 && !isZenMode) {
        updateSyncTextStatus('saving');
        const { error } = await supabase
          .from('game_scores')
          .insert({
            user_id: currentUserId,
            game_slug: slug,
            score: score
          });

        if (error) {
          console.error('Score submit failed:', error.message);
          updateSyncTextStatus('error');
        } else {
          updateSyncTextStatus('saved');
          loadGameLeaderboard(); // refresh specific leaderboard
        }
      } else if (isZenMode) {
        updateSyncTextStatus('zen');
      }

      // Populate Game Over splash screen
      if (overlayTitle) overlayTitle.textContent = 'Game Over';
      if (overlayEmoji) overlayEmoji.textContent = '💀';
      if (overlayText) {
        overlayText.innerHTML = `
          You scored <span class="text-indigo-400 font-extrabold font-display">${score} points</span>.
          ${highscoreBeaten ? '<span class="block text-emerald-400 mt-1 font-semibold">🎉 New Personal Record!</span>' : ''}
          ${!currentUserId ? '<span class="block text-slate-500 text-[10px] mt-2 font-mono">Sign in to save scores to leaderboard.</span>' : ''}
        `;
      }
      if (startBtn) startBtn.textContent = 'Play Again';
      if (overlay) {
        overlay.classList.remove('hidden');
        overlay.classList.add('flex');
      }
    }

    function updateSyncTextStatus(status) {
      const dot = document.getElementById('syncIndicatorDot');
      const text = document.getElementById('syncIndicatorText');
      if (!dot || !text) return;

      if (status === 'saving') {
        dot.className = 'w-2 h-2 rounded-full bg-indigo-400 animate-pulse';
        text.textContent = 'Syncing score...';
      } else if (status === 'saved') {
        dot.className = 'w-2 h-2 rounded-full bg-emerald-500';
        text.textContent = 'Score synced online';
      } else if (status === 'error') {
        dot.className = 'w-2 h-2 rounded-full bg-red-500';
        text.textContent = 'Sync failed';
      } else if (status === 'zen') {
        dot.className = 'w-2 h-2 rounded-full bg-amber-500';
        text.textContent = 'Zen Mode - Sync Disabled';
      }
    }

    function drawGame() {
      const theme = THEMES[currentThemeName];
      
      // Clear Canvas Background
      ctx.fillStyle = theme.bg;
      ctx.fillRect(0, 0, canvas.width, canvas.height);

      // Draw faint Grid Lines
      ctx.strokeStyle = theme.grid;
      ctx.lineWidth = 1;
      for (let i = 0; i <= gridCount; i++) {
        ctx.beginPath();
        ctx.moveTo(i * cellPixelSize, 0);
        ctx.lineTo(i * cellPixelSize, canvas.height);
        ctx.stroke();

        ctx.beginPath();
        ctx.moveTo(0, i * cellPixelSize);
        ctx.lineTo(canvas.width, i * cellPixelSize);
        ctx.stroke();
      }

      // Draw Food
      ctx.fillStyle = theme.food;
      ctx.shadowColor = theme.glow || theme.food;
      ctx.shadowBlur = theme.glowPower || 0;
      ctx.beginPath();
      ctx.roundRect(food.x * cellPixelSize + 2, food.y * cellPixelSize + 2, cellPixelSize - 4, cellPixelSize - 4, 4);
      ctx.fill();
      
      // Reset shadow for snake
      ctx.shadowBlur = 0;

      // Draw Snake
      snake.forEach((part, index) => {
        ctx.fillStyle = index === 0 ? theme.snakeHead : theme.snakeBody;
        ctx.beginPath();
        ctx.roundRect(
          part.x * cellPixelSize + 1, 
          part.y * cellPixelSize + 1, 
          cellPixelSize - 2, 
          cellPixelSize - 2, 
          index === 0 ? 6 : 4
        );
        ctx.fill();
      });
    }

    // Direction handler controls (Arrow keys)
    window.addEventListener('keydown', (e) => {
      if (!isGameActive) return;

      switch (e.key) {
        case 'ArrowUp':
        case 'w':
        case 'W':
          if (direction !== 'down') direction = 'up';
          break;
        case 'ArrowDown':
        case 's':
        case 'S':
          if (direction !== 'up') direction = 'down';
          break;
        case 'ArrowLeft':
        case 'a':
        case 'A':
          if (direction !== 'right') direction = 'left';
          break;
        case 'ArrowRight':
        case 'd':
        case 'D':
          if (direction !== 'left') direction = 'right';
          break;
      }
      
      // Prevent browser default arrow scrolling
      if (['ArrowUp', 'ArrowDown', 'ArrowLeft', 'ArrowRight', ' '].includes(e.key)) {
        e.preventDefault();
      }
    });

    // Virtual D-Pad bindings
    padUp?.addEventListener('click', () => { if (isGameActive && direction !== 'down') direction = 'up'; });
    padDown?.addEventListener('click', () => { if (isGameActive && direction !== 'up') direction = 'down'; });
    padLeft?.addEventListener('click', () => { if (isGameActive && direction !== 'right') direction = 'left'; });
    padRight?.addEventListener('click', () => { if (isGameActive && direction !== 'left') direction = 'right'; });

    // Start triggers
    startBtn?.addEventListener('click', startNewGame);

    initPage();
  </script>
</BaseLayout>
