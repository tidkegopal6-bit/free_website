---
// src/pages/blog/index.astro
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

// Fetch all posts and filter out drafts
const allPosts = await getCollection('blog', ({ data }) => {
  return data.draft !== true;
});

// Helper to parse language and base slug from entry ID
const parsedPosts = allPosts.map(post => {
  const cleanId = post.id.replace(/\.md$/, '');
  const langMatch = cleanId.match(/-([a-z]{2})$/);
  const lang = langMatch?.[1] || 'en';
  const baseSlug = cleanId.replace(/-[a-z]{2}$/, '');
  
  // Calculate reading time roughly (200 words per minute)
  const wordCount = post.body ? post.body.split(/\s+/).length : 0;
  const readTime = Math.max(1, Math.round(wordCount / 200));

  return {
    ...post,
    lang,
    baseSlug,
    readTime,
    url: `/blog/${post.id}`
  };
}).sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

// Collect all unique tags
const allTags = [...new Set(parsedPosts.flatMap(post => post.data.tags))].sort();

// Language map for display
const langNames: Record<string, string> = {
  en: 'English 🇬🇧',
  hi: 'Hindi 🇮🇳',
  mr: 'Marathi 🇮🇳'
};
---

<BaseLayout title="Developer Blog" description="AI-driven, SEO-optimized articles in English, Hindi, and Marathi.">
  <div class="space-y-12">
    <!-- Header -->
    <div class="text-center max-w-2xl mx-auto space-y-4">
      <div class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full border border-purple-500/30 bg-purple-500/5 text-purple-400 text-xs font-semibold tracking-wide uppercase">
        ✍️ Multilingual Blog
      </div>
      <h1 class="text-3xl sm:text-5xl font-display font-extrabold text-slate-100">
        AI-Powered Insight Engine
      </h1>
      <p class="text-slate-400 text-sm sm:text-base leading-relaxed">
        Deep articles on technology, local trends, global updates, and development. Automatically generated, translated, and optimized.
      </p>
    </div>

    <!-- Filters Panel -->
    <div class="flex flex-col md:flex-row gap-4 items-center justify-between p-4 rounded-xl border border-slate-900 bg-slate-950/40 backdrop-blur-sm">
      <!-- Language Filter -->
      <div class="flex flex-wrap items-center gap-2" id="langFilters">
        <span class="text-xs text-slate-500 font-semibold uppercase tracking-wider mr-2">Language:</span>
        <button data-lang="all" class="px-3 py-1.5 text-xs font-medium rounded-lg bg-indigo-500/20 text-indigo-400 border border-indigo-500/30 active-filter transition-all cursor-pointer">
          All
        </button>
        {Object.entries(langNames).map(([code, name]) => (
          <button data-lang={code} class="px-3 py-1.5 text-xs font-medium rounded-lg bg-slate-900 text-slate-400 border border-slate-800 hover:text-slate-200 transition-all cursor-pointer">
            {name}
          </button>
        ))}
      </div>

      <!-- Tag Filter -->
      <div class="flex flex-wrap items-center gap-2" id="tagFilters">
        <span class="text-xs text-slate-500 font-semibold uppercase tracking-wider mr-2">Tag:</span>
        <select id="tagSelect" class="bg-slate-900 border border-slate-800 text-slate-350 focus:outline-none font-semibold px-3 py-1.5 rounded-lg text-xs cursor-pointer">
          <option value="all">All Tags</option>
          {allTags.map(tag => (
            <option value={tag}>#{tag}</option>
          ))}
        </select>
      </div>
    </div>

    <!-- Posts Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6" id="postsGrid">
      {parsedPosts.map(post => (
        <article 
          class="post-card group flex flex-col justify-between p-5 rounded-2xl border border-slate-900 bg-slate-950/30 hover:border-slate-800 hover:shadow-2xl hover:shadow-indigo-500/5 transition-all duration-300 transform hover:-translate-y-1"
          data-lang={post.lang}
          data-tags={post.data.tags.join(',')}
        >
          <div class="space-y-4">
            <!-- Hero Image -->
            {post.data.heroImage && (
              <div class="aspect-video w-full overflow-hidden rounded-xl border border-slate-900 bg-slate-900">
                <img 
                  src={post.data.heroImage} 
                  alt={post.data.title}
                  class="h-full w-full object-cover group-hover:scale-105 transition-transform duration-500"
                  loading="lazy"
                />
              </div>
            )}

            <!-- Meta info -->
            <div class="flex items-center justify-between text-xs text-slate-500 font-mono">
              <time datetime={post.data.pubDate.toISOString()}>
                {post.data.pubDate.toLocaleDateString('en-US', {
                  year: 'numeric',
                  month: 'short',
                  day: 'numeric'
                })}
              </time>
              <div class="flex items-center gap-2">
                <span class="px-2 py-0.5 rounded bg-slate-900 border border-slate-800 text-[10px] text-slate-400">
                  {langNames[post.lang] || post.lang}
                </span>
                <span>•</span>
                <span>{post.readTime} min read</span>
              </div>
            </div>

            <!-- Content -->
            <div class="space-y-2">
              <h2 class="text-lg font-bold text-slate-200 group-hover:text-indigo-300 transition-colors line-clamp-2">
                <a href={post.url}>
                  {post.data.title}
                </a>
              </h2>
              <p class="text-slate-400 text-sm leading-relaxed line-clamp-3">
                {post.data.description}
              </p>
            </div>
          </div>

          <!-- Tags & Link -->
          <div class="pt-4 mt-4 border-t border-slate-900/50 flex items-center justify-between">
            <div class="flex flex-wrap gap-1">
              {post.data.tags.slice(0, 3).map(tag => (
                <span class="text-[10px] text-slate-500 font-medium">#{tag}</span>
              ))}
            </div>
            <a href={post.url} class="text-xs font-semibold text-indigo-400 hover:text-indigo-300 transition-colors flex items-center gap-1">
              Read &rarr;
            </a>
          </div>
        </article>
      ))}
    </div>

    <!-- Empty State -->
    <div id="emptyState" class="hidden text-center py-20 border border-dashed border-slate-900 rounded-2xl">
      <span class="text-4xl">📭</span>
      <h3 class="text-lg font-semibold text-slate-300 mt-4">No articles found</h3>
      <p class="text-slate-500 text-sm mt-1">Try resetting your language or tag filter.</p>
    </div>
  </div>

  <!-- Client-side filtering script -->
  <script>
    const langButtons = document.querySelectorAll('#langFilters button');
    const tagSelect = document.getElementById('tagSelect') as HTMLSelectElement;
    const postCards = document.querySelectorAll('.post-card');
    const emptyState = document.getElementById('emptyState');

    let activeLang = 'all';
    let activeTag = 'all';

    function filterPosts() {
      let visibleCount = 0;

      postCards.forEach(card => {
        const cardLang = card.getAttribute('data-lang') || '';
        const cardTags = (card.getAttribute('data-tags') || '').split(',');

        const langMatch = activeLang === 'all' || cardLang === activeLang;
        const tagMatch = activeTag === 'all' || cardTags.includes(activeTag);

        if (langMatch && tagMatch) {
          card.classList.remove('hidden');
          visibleCount++;
        } else {
          card.classList.add('hidden');
        }
      });

      if (visibleCount === 0) {
        emptyState?.classList.remove('hidden');
      } else {
        emptyState?.classList.add('hidden');
      }
    }

    // Language Filter triggers
    langButtons.forEach(btn => {
      btn.addEventListener('click', () => {
        // Reset old active style
        langButtons.forEach(b => {
          b.classList.remove('bg-indigo-500/20', 'text-indigo-400', 'border-indigo-500/30', 'active-filter');
          b.classList.add('bg-slate-900', 'text-slate-400', 'border-slate-800');
        });

        // Add active style
        btn.classList.add('bg-indigo-500/20', 'text-indigo-400', 'border-indigo-500/30', 'active-filter');
        btn.classList.remove('bg-slate-900', 'text-slate-400', 'border-slate-800');

        activeLang = btn.getAttribute('data-lang') || 'all';
        filterPosts();
      });
    });

    // Tag Filter triggers
    tagSelect?.addEventListener('change', (e) => {
      const target = e.target as HTMLSelectElement;
      activeTag = target.value;
      filterPosts();
    });
  </script>
</BaseLayout>
