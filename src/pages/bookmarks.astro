---
// src/pages/bookmarks.astro
export const prerender = false;
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Bookmarks" description="Save, organize, and filter your favorite links and resources.">
  
  <!-- Loading skeleton view -->
  <div id="loadingView" class="max-w-5xl mx-auto flex items-center justify-center min-h-[40vh]">
    <div class="flex flex-col items-center space-y-4">
      <div class="animate-spin rounded-full h-8 w-8 border-t-2 border-b-2 border-indigo-500"></div>
      <p class="text-xs text-slate-500 font-mono">Syncing Bookmarks Database...</p>
    </div>
  </div>

  <!-- Bookmarks Container (hidden by default, shown by JS) -->
  <div id="bookmarksContainer" class="max-w-5xl mx-auto hidden space-y-8 animate-fade-in">
    
    <!-- Header -->
    <div class="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4 pb-6 border-b border-slate-900">
      <div>
        <h1 class="text-3xl font-display font-extrabold text-slate-100 tracking-tight">
          Bookmarks Hub
        </h1>
        <p class="text-sm text-slate-400 mt-1 font-light">
          Catalog and tag your developer links, tools, and reading bookmarks.
        </p>
      </div>
      <button id="toggleFormBtn" class="px-4 py-2 bg-slate-900 border border-slate-800 hover:border-slate-700 text-slate-200 hover:text-slate-100 text-xs font-semibold rounded-xl transition-all cursor-pointer">
        + Add New Link
      </button>
    </div>

    <!-- Add Bookmark Form Card (hidden by default) -->
    <div id="addFormCard" class="hidden p-6 rounded-2xl bg-slate-950/60 border border-slate-900 shadow-xl space-y-4 animate-fade-in">
      <h3 class="text-base font-bold text-slate-200 font-display">Save New Bookmark</h3>
      <form id="bookmarkForm" class="grid grid-cols-1 md:grid-cols-2 gap-4">
        <div>
          <label class="block text-xs font-bold text-slate-500 uppercase tracking-wide mb-1" for="bookmarkUrl">Destination URL</label>
          <input id="bookmarkUrl" class="w-full px-4 py-2.5 rounded-lg bg-slate-950 border border-slate-900 focus:border-indigo-500/50 text-slate-100 text-sm focus:outline-none transition-colors" type="url" placeholder="https://example.com" required />
        </div>
        <div>
          <label class="block text-xs font-bold text-slate-500 uppercase tracking-wide mb-1" for="bookmarkTitle">Title / Caption</label>
          <input id="bookmarkTitle" class="w-full px-4 py-2.5 rounded-lg bg-slate-950 border border-slate-900 focus:border-indigo-500/50 text-slate-100 text-sm focus:outline-none transition-colors" type="text" placeholder="Astro Documentation" required />
        </div>
        <div class="md:col-span-2">
          <label class="block text-xs font-bold text-slate-500 uppercase tracking-wide mb-1" for="bookmarkTags">Tags (comma-separated)</label>
          <input id="bookmarkTags" class="w-full px-4 py-2.5 rounded-lg bg-slate-950 border border-slate-900 focus:border-indigo-500/50 text-slate-100 text-sm focus:outline-none transition-colors" type="text" placeholder="astro, docs, templates" />
        </div>
        <div class="md:col-span-2">
          <label class="block text-xs font-bold text-slate-500 uppercase tracking-wide mb-1" for="bookmarkNotes">Notes / Description</label>
          <textarea id="bookmarkNotes" class="w-full px-4 py-2.5 rounded-lg bg-slate-950 border border-slate-900 focus:border-indigo-500/50 text-slate-100 text-sm focus:outline-none transition-colors h-20 resize-none" placeholder="Useful tools and layouts..."></textarea>
        </div>
        <div class="md:col-span-2 flex justify-end gap-3 pt-2">
          <button id="cancelFormBtn" type="button" class="px-4 py-2 rounded-lg text-xs font-semibold text-slate-400 hover:text-slate-300 cursor-pointer">Cancel</button>
          <button id="saveBtn" type="submit" class="px-5 py-2 rounded-lg text-xs font-semibold text-slate-100 bg-indigo-600 hover:bg-indigo-500 shadow-md hover:shadow-indigo-500/20 cursor-pointer transition-all">Save Bookmark</button>
        </div>
      </form>
    </div>

    <!-- Dynamic Tag Filter Row -->
    <div id="filterRow" class="flex flex-wrap items-center gap-2 pb-4">
      <span class="text-xs font-bold text-slate-500 uppercase tracking-wide mr-2">Filter by:</span>
      <button class="filter-tag-btn px-3 py-1 rounded-full text-xs font-medium border border-indigo-500/30 bg-indigo-500/10 text-indigo-300 transition-all cursor-pointer active-filter" data-tag="all">
        All Links
      </button>
      <!-- Sub-tags generated dynamically -->
    </div>

    <!-- Empty State -->
    <div id="emptyState" class="hidden p-12 text-center rounded-2xl border border-dashed border-slate-900 bg-slate-950/20">
      <span class="text-4xl block mb-4">🔖</span>
      <h3 class="text-slate-300 font-semibold mb-1">No bookmarks cataloged</h3>
      <p class="text-xs text-slate-500 max-w-sm mx-auto mb-6">
        Save guides, libraries, and resources to build your catalog list.
      </p>
    </div>

    <!-- Grid Layout -->
    <div id="bookmarksGrid" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
      <!-- Cards rendered dynamically -->
    </div>
  </div>

  <script>
    import { supabase } from '../lib/supabase';

    const loadingView = document.getElementById('loadingView');
    const bookmarksContainer = document.getElementById('bookmarksContainer');
    const emptyState = document.getElementById('emptyState');
    const bookmarksGrid = document.getElementById('bookmarksGrid');
    const filterRow = document.getElementById('filterRow');

    // Form Controls
    const toggleFormBtn = document.getElementById('toggleFormBtn');
    const addFormCard = document.getElementById('addFormCard');
    const cancelFormBtn = document.getElementById('cancelFormBtn');
    const bookmarkForm = document.getElementById('bookmarkForm') as HTMLFormElement;
    const saveBtn = document.getElementById('saveBtn');

    // Form Inputs
    const bookmarkUrl = document.getElementById('bookmarkUrl') as HTMLInputElement;
    const bookmarkTitle = document.getElementById('bookmarkTitle') as HTMLInputElement;
    const bookmarkTags = document.getElementById('bookmarkTags') as HTMLInputElement;
    const bookmarkNotes = document.getElementById('bookmarkNotes') as HTMLTextAreaElement;

    let currentUserId: string | null = null;
    let localBookmarksList: any[] = [];
    let activeFilterTag = 'all';

    async function checkAuthAndLoadBookmarks() {
      // 1. Session Verify
      const { data: { session } } = await supabase.auth.getSession();
      if (!session) {
        window.location.href = '/login';
        return;
      }
      currentUserId = session.user.id;

      // 2. Fetch bookmarks
      const { data: bookmarks, error } = await supabase
        .from('bookmarks')
        .select('*')
        .eq('user_id', currentUserId)
        .order('created_at', { ascending: false });

      if (error) {
        console.error('Bookmarks fetch failed:', error.message);
        return;
      }

      localBookmarksList = bookmarks || [];

      // Hide loading, show content
      if (loadingView && bookmarksContainer) {
        loadingView.classList.add('hidden');
        bookmarksContainer.classList.remove('hidden');
      }

      applyFilterAndRender();
      renderTagFilters();
    }

    function renderTagFilters() {
      if (!filterRow) return;

      // Extract unique tags
      const allTagsSet = new Set<string>();
      localBookmarksList.forEach(b => {
        if (b.tags && Array.isArray(b.tags)) {
          b.tags.forEach((t: string) => {
            const clean = t.trim().toLowerCase();
            if (clean) allTagsSet.add(clean);
          });
        }
      });

      // Clear dynamically generated tag buttons (keep "All Links")
      const dynamicButtons = filterRow.querySelectorAll('.dynamic-filter-tag');
      dynamicButtons.forEach(btn => btn.remove());

      Array.from(allTagsSet).sort().forEach(tag => {
        const btn = document.createElement('button');
        btn.className = `dynamic-filter-tag px-3 py-1 rounded-full text-xs font-medium border border-slate-900 bg-slate-950/40 text-slate-400 hover:text-slate-200 transition-all cursor-pointer`;
        btn.setAttribute('data-tag', tag);
        btn.textContent = tag;
        
        btn.addEventListener('click', (e) => {
          const target = e.currentTarget as HTMLButtonElement;
          updateActiveFilterStyle(target);
          activeFilterTag = tag;
          applyFilterAndRender();
        });

        filterRow.appendChild(btn);
      });
    }

    function updateActiveFilterStyle(activeBtn: HTMLButtonElement) {
      if (!filterRow) return;
      const allButtons = filterRow.querySelectorAll('button');
      allButtons.forEach(btn => {
        btn.className = btn.className.replace(
          'border-indigo-500/30 bg-indigo-500/10 text-indigo-300',
          'border-slate-900 bg-slate-950/40 text-slate-400'
        );
      });
      activeBtn.className = activeBtn.className.replace(
        'border-slate-900 bg-slate-950/40 text-slate-400',
        'border-indigo-500/30 bg-indigo-500/10 text-indigo-300'
      );
    }

    // Default "All Links" trigger
    const allFilterBtn = filterRow?.querySelector('[data-tag="all"]') as HTMLButtonElement;
    allFilterBtn?.addEventListener('click', () => {
      updateActiveFilterStyle(allFilterBtn);
      activeFilterTag = 'all';
      applyFilterAndRender();
    });

    function applyFilterAndRender() {
      if (!bookmarksGrid) return;

      const filtered = activeFilterTag === 'all'
        ? localBookmarksList
        : localBookmarksList.filter(b => b.tags?.map((t: string) => t.toLowerCase()).includes(activeFilterTag));

      if (filtered.length === 0) {
        bookmarksGrid.innerHTML = '';
        if (emptyState) emptyState.classList.remove('hidden');
        return;
      }

      if (emptyState) emptyState.classList.add('hidden');
      renderGridCards(filtered);
    }

    function renderGridCards(bookmarks: any[]) {
      if (!bookmarksGrid) return;
      bookmarksGrid.innerHTML = '';

      bookmarks.forEach(b => {
        const hostname = new URL(b.url).hostname;
        const tagBadges = b.tags && b.tags.length > 0
          ? b.tags.map((t: string) => `<span class="px-2 py-0.5 rounded text-[9px] font-bold border border-indigo-500/10 bg-indigo-500/5 text-indigo-400/80">${t.trim()}</span>`).join(' ')
          : '';

        const card = document.createElement('div');
        card.className = 'p-5 rounded-2xl border border-slate-900 bg-slate-950/40 hover:border-slate-800 transition-all duration-200 group flex flex-col justify-between';
        card.innerHTML = `
          <div>
            <div class="flex items-start justify-between gap-3 mb-2">
              <a href="${b.url}" target="_blank" rel="noopener noreferrer" class="font-display font-bold text-slate-200 group-hover:text-indigo-400 transition-colors truncate text-sm hover:underline flex items-center gap-1">
                ${b.title}
                <svg class="w-3.5 h-3.5 text-slate-600 group-hover:text-indigo-500/70" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 6H5.25A2.25 2.25 0 003 8.25v10.5A2.25 2.25 0 005.25 21h10.5A2.25 2.25 0 0018 18.75V10.5m-10.5 6L21 3m0 0h-5.25M21 3v5.25"/>
                </svg>
              </a>
            </div>
            <p class="text-[10px] text-slate-500 font-mono mb-3 truncate">${hostname}</p>
            ${b.notes ? `<p class="text-xs text-slate-400 leading-relaxed font-light mb-4">${b.notes}</p>` : ''}
          </div>
          <div class="flex flex-col gap-3 pt-4 border-t border-slate-900/50 mt-auto">
            <div class="flex flex-wrap gap-1.5">${tagBadges}</div>
            <div class="flex items-center justify-between text-[10px] text-slate-600 font-mono">
              <span>${new Date(b.created_at).toLocaleDateString()}</span>
              <button class="delete-bookmark-btn text-[10px] font-semibold text-red-500/70 hover:text-red-400 cursor-pointer transition-colors" data-id="${b.id}">
                Delete
              </button>
            </div>
          </div>
        `;
        bookmarksGrid.appendChild(card);
      });

      // Bind delete events
      const deleteButtons = bookmarksGrid.querySelectorAll('.delete-bookmark-btn');
      deleteButtons.forEach(btn => {
        btn.addEventListener('click', async (e) => {
          const target = e.currentTarget as HTMLButtonElement;
          const id = target.getAttribute('data-id');
          if (!id) return;

          if (confirm('Delete this bookmark link?')) {
            target.setAttribute('disabled', 'true');
            target.textContent = 'Deleting...';

            const { error } = await supabase
              .from('bookmarks')
              .delete()
              .eq('id', id);

            if (error) {
              alert(`Error: ${error.message}`);
              target.removeAttribute('disabled');
              target.textContent = 'Delete';
            } else {
              checkAuthAndLoadBookmarks();
            }
          }
        });
      });
    }

    // Modal Form Toggle Buttons
    if (toggleFormBtn && addFormCard) {
      toggleFormBtn.addEventListener('click', () => {
        addFormCard.classList.toggle('hidden');
        toggleFormBtn.textContent = addFormCard.classList.contains('hidden') ? '+ Add New Link' : 'Close Form';
      });
    }

    if (cancelFormBtn && addFormCard && toggleFormBtn) {
      cancelFormBtn.addEventListener('click', () => {
        addFormCard.classList.add('hidden');
        toggleFormBtn.textContent = '+ Add New Link';
      });
    }

    // Submit Bookmark
    if (bookmarkForm && saveBtn && addFormCard && toggleFormBtn) {
      bookmarkForm.addEventListener('submit', async (e) => {
        e.preventDefault();
        if (!currentUserId) return;

        saveBtn.setAttribute('disabled', 'true');
        saveBtn.textContent = 'Saving...';

        const url = bookmarkUrl.value.trim();
        const title = bookmarkTitle.value.trim();
        const rawTags = bookmarkTags.value.trim();
        const notes = bookmarkNotes.value.trim();

        // Convert tags to clean lowercase array
        const tags = rawTags
          ? rawTags.split(',').map(t => t.trim().toLowerCase()).filter(t => t.length > 0)
          : [];

        const { error } = await supabase
          .from('bookmarks')
          .insert({
            user_id: currentUserId,
            url,
            title,
            tags,
            notes: notes || null
          });

        saveBtn.removeAttribute('disabled');
        saveBtn.textContent = 'Save Bookmark';

        if (error) {
          alert(`Save failed: ${error.message}`);
        } else {
          // Clear inputs & toggle
          bookmarkForm.reset();
          addFormCard.classList.add('hidden');
          toggleFormBtn.textContent = '+ Add New Link';
          checkAuthAndLoadBookmarks();
        }
      });
    }

    checkAuthAndLoadBookmarks();
  </script>
</BaseLayout>
